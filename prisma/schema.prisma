// InkStory Prisma schema — Epic 0 (Foundation) & Epic 1 (Codex)
// See Linear project: https://linear.app/jgfdev/project/novel-writing-app-3c3f658f0d44
//
// This schema covers:
//   - STO-1150 (Core Database Schema): User, Series, Novel, Act, Chapter, Scene
//   - STO-1167 (Codex Database Schema): CodexEntry, CodexAlias, CodexTag, CodexRelation, CodexProgression
//   - Hierarchical story structure (Series → Novel → Act → Chapter → Scene)
//   - Soft deletes + timestamps on all entities
//   - POV / tense / content fields on Scene
//   - Orderable positioning (drag-and-drop ready via `position`)
//   - Full Codex story bible models with aliases, tags, graph relations, and scene progressions
//
// Authz / deploy notes (STO-1167):
//   - Prisma Compute is the source of truth for applying this schema.
//   - Child Codex rows have no ownerId; authz is join-to-entry via Prisma service role.
//   - RLS policies are intentionally deferred.
//   - Novel XOR series (+ seriesScoped alignment), soft-delete-safe partial unique
//     indexes, and source!=target relation CHECKs are parked for STO-1168.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Supabase Postgres connection.
  // URL is declared in prisma.config.ts (required by Prisma 7).
  // See: https://pris.ly/d/config-datasource
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Pov {
  FIRST
  SECOND
  THIRD_LIMITED
  THIRD_OMNISCIENT
}

enum Tense {
  PAST
  PRESENT
  FUTURE
}

enum ContentFormat {
  PLAIN
  TIPTAP_JSON
}

enum SceneRevisionReason {
  AUTOSAVE
  MANUAL
  RESTORE
  IMPORT
}

enum CodexType {
  CHARACTER
  LOCATION
  ITEM
  LORE
  FACTION
  CONCEPT
  OTHER
}

enum CodexTrackingMode {
  ALWAYS
  DETECTED
  NEVER
}

enum ProgressionMode {
  ADDITION
  REPLACEMENT
}

enum AiProvider {
  OPENROUTER
  OPENAI
  ANTHROPIC
  OLLAMA
  LMSTUDIO
}

enum PromptRole {
  SYSTEM
  USER
}

enum PromptScope {
  SYSTEM_DEFAULT
  USER
  NOVEL
}

// ─── User ────────────────────────────────────────────────────────────────────
//
// Synced 1:1 from Supabase auth.users (see src/lib/supabase/auth.ts onAuthUser).
// We don't duplicate auth state — Supabase owns passwords, sessions, OAuth.

model User {
  id        String    @id // Supabase auth user id (uuid)
  email     String    @unique
  name      String?
  avatarUrl String?   @map("avatar_url")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  series              Series[]
  novels              Novel[]
  codexEntries        CodexEntry[]
  providerCredentials UserProviderCredential[]
  prompts             Prompt[]
  promptComponents    PromptComponent[]

  @@index([deletedAt])
  @@map("users")
}

// ─── Series ──────────────────────────────────────────────────────────────────
//
// A series groups one or more Novels (e.g. a trilogy). Series Codex entries
// are shared across books — that feature ships in Epic 5 (STO-1164).

model Series {
  id          String    @id @default(cuid())
  title       String
  description String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  novels       Novel[]
  codexEntries CodexEntry[]

  @@index([ownerId, deletedAt])
  @@index([ownerId, position])
  @@map("series")
}

// ─── Novel ───────────────────────────────────────────────────────────────────

model Novel {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Optional: a Novel may belong to a Series, or stand alone.
  seriesId String? @map("series_id")
  series   Series? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  acts         Act[]
  codexEntries CodexEntry[]
  prompts      Prompt[]

  @@index([ownerId, deletedAt])
  @@index([seriesId])
  @@index([ownerId, position])
  @@map("novels")
}

// ─── Act ─────────────────────────────────────────────────────────────────────

model Act {
  id        String    @id @default(cuid())
  title     String
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  novelId String @map("novel_id")
  novel   Novel  @relation(fields: [novelId], references: [id], onDelete: Cascade)

  chapters Chapter[]

  @@index([novelId, deletedAt])
  @@index([novelId, position])
  @@map("acts")
}

// ─── Chapter ─────────────────────────────────────────────────────────────────

model Chapter {
  id        String    @id @default(cuid())
  title     String
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  actId String @map("act_id")
  act   Act    @relation(fields: [actId], references: [id], onDelete: Cascade)

  scenes Scene[]

  @@index([actId, deletedAt])
  @@index([actId, position])
  @@map("chapters")
}

// ─── Scene ───────────────────────────────────────────────────────────────────
//
// The atomic writing unit. `content` stays the authoritative plain-text extract
// for AI / word-count / import; `content_doc` holds Tiptap JSON (STO-1156).

model Scene {
  id            String        @id @default(cuid())
  title         String
  label         String? // short tag (e.g. "Battle", "Reveal")
  subtitle      String?
  content       String        @default("") @db.Text // plain extract — KEEP
  contentDoc    Json?         @map("content_doc") // Tiptap JSON; null = plain-only
  contentFormat ContentFormat @default(PLAIN) @map("content_format")
  summary       String?       @db.Text
  pov           Pov           @default(THIRD_LIMITED)
  tense         Tense         @default(PAST)
  position      Int           @default(0)
  excludeFromAi Boolean       @default(false) @map("exclude_from_ai")
  wordCount     Int           @default(0) @map("word_count")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  chapterId String  @map("chapter_id")
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  progressions CodexProgression[]
  revisions    SceneRevision[]

  @@index([chapterId, deletedAt])
  @@index([chapterId, position])
  @@map("scenes")
}

// ─── Scene Revision ──────────────────────────────────────────────────────────
//
// Snapshot of editor-relevant scene fields at save/restore time (STO-1156).
// Authz is via the scene → chapter → act → novel owner chain — no ownerId here.

model SceneRevision {
  id            String              @id @default(cuid())
  sceneId       String              @map("scene_id")
  scene         Scene               @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  title         String
  content       String              @db.Text
  contentDoc    Json?               @map("content_doc")
  contentFormat ContentFormat       @default(PLAIN) @map("content_format")
  summary       String?             @db.Text
  pov           Pov
  tense         Tense
  wordCount     Int                 @map("word_count")
  reason        SceneRevisionReason @default(AUTOSAVE)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sceneId, createdAt])
  @@map("scene_revisions")
}

// ─── Codex Entry ─────────────────────────────────────────────────────────────
//
// The core building block of the story bible (Character, Location, Item, etc.).
// Entries can be scoped to a specific novel or shared across an entire series.
// Invariant (parked for STO-1168): exactly one of novelId / seriesId should be
// set, and seriesScoped must match that choice. Seed data follows this today.

model CodexEntry {
  id           String            @id @default(cuid())
  name         String
  type         CodexType         @default(CHARACTER)
  description  String            @default("") @db.Text
  notes        String?           @db.Text
  trackingMode CodexTrackingMode @default(DETECTED) @map("tracking_mode")
  seriesScoped Boolean           @default(false) @map("series_scoped")
  customFields Json?             @map("custom_fields")
  color        String?
  thumbnailUrl String?           @map("thumbnail_url")
  position     Int               @default(0)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  novelId String? @map("novel_id")
  novel   Novel?  @relation(fields: [novelId], references: [id], onDelete: Cascade)

  seriesId String? @map("series_id")
  series   Series? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  aliases         CodexAlias[]
  tags            CodexTag[]
  sourceRelations CodexRelation[]    @relation("SourceRelations")
  targetRelations CodexRelation[]    @relation("TargetRelations")
  progressions    CodexProgression[]

  @@index([ownerId, deletedAt])
  @@index([ownerId, novelId, deletedAt])
  @@index([ownerId, seriesId, deletedAt])
  @@index([novelId, deletedAt])
  @@index([seriesId, deletedAt])
  @@map("codex_entries")
}

// ─── Codex Alias ─────────────────────────────────────────────────────────────
//
// Alternative names / monikers for mention detection (e.g. "The White Wolf").
// Soft-delete-safe unique (entryId, name) WHERE deleted_at IS NULL → STO-1168.

model CodexAlias {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  entryId String     @map("entry_id")
  entry   CodexEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, deletedAt])
  @@index([entryId, name])
  @@map("codex_aliases")
}

// ─── Codex Tag ───────────────────────────────────────────────────────────────
//
// Per-entry category / thematic labels (e.g. "Protagonist", "Nobility").
// Not a shared vocabulary + join table; STO-1167 intentionally uses child rows.
// Soft-delete-safe unique (entryId, name) WHERE deleted_at IS NULL → STO-1168.

model CodexTag {
  id        String    @id @default(cuid())
  name      String
  color     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  entryId String     @map("entry_id")
  entry   CodexEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, deletedAt])
  @@index([entryId, name])
  @@map("codex_tags")
}

// ─── Codex Relation ──────────────────────────────────────────────────────────
//
// Directed graph relationship between two codex entries (e.g. Alice -> SIBLING -> Bob).
// Cycle prevention and source!=target CHECK are out of scope here (STO-1154 / STO-1168).
// Soft-delete-safe unique (source, target, relationType) WHERE deleted_at IS NULL → STO-1168.

model CodexRelation {
  id           String    @id @default(cuid())
  relationType String    @map("relation_type")
  reverseType  String?   @map("reverse_type")
  description  String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  sourceEntryId String     @map("source_entry_id")
  sourceEntry   CodexEntry @relation("SourceRelations", fields: [sourceEntryId], references: [id], onDelete: Cascade)

  targetEntryId String     @map("target_entry_id")
  targetEntry   CodexEntry @relation("TargetRelations", fields: [targetEntryId], references: [id], onDelete: Cascade)

  @@index([sourceEntryId, deletedAt])
  @@index([targetEntryId, deletedAt])
  @@index([sourceEntryId, targetEntryId, relationType])
  @@map("codex_relations")
}

// ─── Codex Progression ───────────────────────────────────────────────────────
//
// Scene-linked temporal evolution of a Codex entry (addition or replacement of state).

model CodexProgression {
  id          String          @id @default(cuid())
  mode        ProgressionMode @default(ADDITION)
  description String          @db.Text
  notes       String?         @db.Text
  position    Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  entryId String     @map("entry_id")
  entry   CodexEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  sceneId String @map("scene_id")
  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([entryId, deletedAt])
  @@index([entryId, position])
  @@index([sceneId, deletedAt])
  @@index([sceneId, position])
  @@map("codex_progressions")
}

// ─── User Provider Credential (STO-1178 BYOK) ────────────────────────────────
//
// AES-256-GCM envelope encryption with BYOK_ENCRYPTION_KEY. Soft-delete-safe
// uniqueness (ownerId, provider, label) WHERE deleted_at IS NULL is enforced
// in the service layer (partial unique parked for STO-1168).

model UserProviderCredential {
  id         String     @id @default(cuid())
  ownerId    String     @map("owner_id")
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  provider   AiProvider
  label      String     @default("default")

  ciphertext Bytes?
  iv         Bytes?
  authTag    Bytes?     @map("auth_tag")
  keyHint    String?    @map("key_hint")
  keyVersion Int        @default(1) @map("key_version")

  baseUrl      String?  @map("base_url")
  defaultModel String?  @map("default_model")
  defaultTemp  Float?   @map("default_temp")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([ownerId, deletedAt])
  @@index([ownerId, provider, deletedAt])
  @@map("user_provider_credentials")
}

// ─── Prompt Model (STO-1158) ─────────────────────────────────────────────────
//
// Template + ordered component composition for generation modes. SYSTEM_DEFAULT
// rows are seeded read-only; authors Duplicate to their library. Variable
// catalog is a frozen closed set (see src/lib/prompts/catalog.ts).

model Prompt {
  id          String      @id @default(cuid())
  name        String
  description String?     @db.Text
  mode        String
  scope       PromptScope @default(USER)
  body        String      @default("") @db.Text
  role        PromptRole  @default(SYSTEM)
  position    Int         @default(0)
  isActive    Boolean     @default(true) @map("is_active")

  ownerId     String?     @map("owner_id")
  owner       User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  novelId     String?     @map("novel_id")
  novel       Novel?      @relation(fields: [novelId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  components  PromptComponentLink[]

  @@index([ownerId, deletedAt])
  @@index([novelId, deletedAt])
  @@index([mode, isActive, deletedAt])
  @@map("prompts")
}

model PromptComponent {
  id          String     @id @default(cuid())
  name        String
  description String?    @db.Text
  body        String     @db.Text
  role        PromptRole @default(SYSTEM)

  ownerId     String?    @map("owner_id")
  owner       User?      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  links       PromptComponentLink[]

  @@index([ownerId, deletedAt])
  @@map("prompt_components")
}

model PromptComponentLink {
  id          String @id @default(cuid())
  promptId    String @map("prompt_id")
  prompt      Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  componentId String @map("component_id")
  component   PromptComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  position    Int    @default(0)
  enabled     Boolean @default(true)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([promptId, position])
  @@index([componentId])
  @@map("prompt_component_links")
}
