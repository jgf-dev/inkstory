// use prisma-next
// InkStory Prisma 8 Contract (PostgreSQL PSL)

namespace public {
  model User {
    id           String             @id(map: "users_pkey")
    email        String
    name         String?
    avatarUrl    String?            @map("avatar_url")
    createdAt    Timestamp(3)       @default(now()) @map("created_at")
    updatedAt    Timestamp(3)       @map("updated_at")
    deletedAt    Timestamp(3)?      @map("deleted_at")

    // Stripe billing (STO-1180). planTier is the source of truth for
    // entitlements; stripe* fields mirror the Stripe customer/subscription so
    // webhooks can match rows and the billing portal can look up the customer.
    stripeCustomerId     String?             @unique @map("stripe_customer_id")
    stripeSubscriptionId String?             @unique @map("stripe_subscription_id")
    planTier             pg.enum(PlanTier)   @default("FREE") @map("plan_tier")
    subscriptionStatus   String?             @map("subscription_status")
    currentPeriodEnd     Timestamp(3)?       @map("current_period_end")

    series               Series[]
    novels               Novel[]
    codexEntries         CodexEntry[]
    providerCredentials  UserProviderCredential[]
    prompts              Prompt[]
    promptComponents     PromptComponent[]

    @@index([deletedAt], map: "users_deleted_at_idx")
    @@index([email], map: "users_email_key", unique: true)
    @@map("users")
  }

  model StripeWebhookEvent {
    id        String      @id(map: "stripe_webhook_events_pkey")
    // Stripe event object id (evt_...); unique for idempotent processing.
    eventId   String      @unique @map("event_id")
    type      String
    payload   Jsonb?      @map("payload")
    createdAt Timestamp(3) @default(now()) @map("created_at")

    @@map("stripe_webhook_events")
  }

  model Series {
    id           String             @id(map: "series_pkey")
    title        String
    description  String?
    position     Int                @default(0)
    createdAt    Timestamp(3)       @default(now()) @map("created_at")
    updatedAt    Timestamp(3)       @map("updated_at")
    deletedAt    Timestamp(3)?      @map("deleted_at")
    ownerId      String             @map("owner_id")

    owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "series_owner_id_fkey", index: false)
    novels       Novel[]
    codexEntries CodexEntry[]

    @@index([ownerId, deletedAt], map: "series_owner_id_deleted_at_idx")
    @@index([ownerId, position], map: "series_owner_id_position_idx")
    @@map("series")
  }

  model Novel {
    id           String             @id(map: "novels_pkey")
    title        String
    subtitle     String?
    description  String?
    position     Int                @default(0)
    createdAt    Timestamp(3)       @default(now()) @map("created_at")
    updatedAt    Timestamp(3)       @map("updated_at")
    deletedAt    Timestamp(3)?      @map("deleted_at")
    ownerId      String             @map("owner_id")
    seriesId     String?            @map("series_id")

    owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "novels_owner_id_fkey", index: false)
    series       Series?            @relation(fields: [seriesId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "novels_series_id_fkey")
    acts         Act[]
    codexEntries CodexEntry[]
    prompts      Prompt[]

    @@index([ownerId, deletedAt], map: "novels_owner_id_deleted_at_idx")
    @@index([ownerId, position], map: "novels_owner_id_position_idx")
    @@index([seriesId], map: "novels_series_id_idx")
    @@map("novels")
  }

  model Act {
    id        String        @id(map: "acts_pkey")
    title     String
    position  Int           @default(0)
    createdAt Timestamp(3)  @default(now()) @map("created_at")
    updatedAt Timestamp(3)  @map("updated_at")
    deletedAt Timestamp(3)? @map("deleted_at")
    novelId   String        @map("novel_id")

    novel     Novel         @relation(fields: [novelId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "acts_novel_id_fkey", index: false)
    chapters  Chapter[]

    @@index([novelId, deletedAt], map: "acts_novel_id_deleted_at_idx")
    @@index([novelId, position], map: "acts_novel_id_position_idx")
    @@map("acts")
  }

  model Chapter {
    id        String        @id(map: "chapters_pkey")
    title     String
    position  Int           @default(0)
    createdAt Timestamp(3)  @default(now()) @map("created_at")
    updatedAt Timestamp(3)  @map("updated_at")
    deletedAt Timestamp(3)? @map("deleted_at")
    actId     String        @map("act_id")

    act       Act           @relation(fields: [actId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "chapters_act_id_fkey", index: false)
    scenes    Scene[]

    @@index([actId, deletedAt], map: "chapters_act_id_deleted_at_idx")
    @@index([actId, position], map: "chapters_act_id_position_idx")
    @@map("chapters")
  }

  model Scene {
    id                String                   @id(map: "scenes_pkey")
    title             String
    label             String?
    subtitle          String?
    content           String                   @default("")
    contentDoc        Jsonb?                   @map("content_doc")
    contentFormat     pg.enum(ContentFormat)   @default("PLAIN") @map("content_format")
    summary           String?
    pov               pg.enum(Pov)             @default("THIRD_LIMITED")
    tense             pg.enum(Tense)           @default("PAST")
    position          Int                      @default(0)
    excludeFromAi     Boolean                  @default(false) @map("exclude_from_ai")
    wordCount         Int                      @default(0) @map("word_count")
    createdAt         Timestamp(3)             @default(now()) @map("created_at")
    updatedAt         Timestamp(3)             @map("updated_at")
    deletedAt         Timestamp(3)?            @map("deleted_at")
    chapterId         String                   @map("chapter_id")

    chapter           Chapter                  @relation(fields: [chapterId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "scenes_chapter_id_fkey", index: false)
    codexProgressions CodexProgression[]
    revisions         SceneRevision[]

    @@index([chapterId, deletedAt], map: "scenes_chapter_id_deleted_at_idx")
    @@index([chapterId, position], map: "scenes_chapter_id_position_idx")
    @@map("scenes")
  }

  // Scene revision snapshots (STO-1156). Authz via scene → novel owner chain.
  model SceneRevision {
    id            String                       @id(map: "scene_revisions_pkey")
    sceneId       String                       @map("scene_id")
    title         String
    content       String
    contentDoc    Jsonb?                       @map("content_doc")
    contentFormat pg.enum(ContentFormat)       @default("PLAIN") @map("content_format")
    summary       String?
    pov           pg.enum(Pov)
    tense         pg.enum(Tense)
    wordCount     Int                          @map("word_count")
    reason        pg.enum(SceneRevisionReason) @default("AUTOSAVE")
    createdAt     Timestamp(3)                 @default(now()) @map("created_at")

    scene         Scene                        @relation(fields: [sceneId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "scene_revisions_scene_id_fkey", index: false)

    @@index([sceneId, createdAt], map: "scene_revisions_scene_id_created_at_idx")
    @@map("scene_revisions")
  }

  model CodexEntry {
    id                           String                     @id(map: "codex_entries_pkey")
    name                         String
    type                         pg.enum(CodexType)         @default("CHARACTER")
    description                  String                     @default("")
    notes                        String?
    trackingMode                 pg.enum(CodexTrackingMode) @default("DETECTED") @map("tracking_mode")
    seriesScoped                 Boolean                    @default(false) @map("series_scoped")
    customFields                 Jsonb?                     @map("custom_fields")
    color                        String?
    thumbnailUrl                 String?                    @map("thumbnail_url")
    position                     Int                        @default(0)
    createdAt                    Timestamp(3)               @default(now()) @map("created_at")
    updatedAt                    Timestamp(3)               @map("updated_at")
    deletedAt                    Timestamp(3)?              @map("deleted_at")
    ownerId                      String                     @map("owner_id")
    novelId                      String?                    @map("novel_id")
    seriesId                     String?                    @map("series_id")

    owner                        User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "codex_entries_owner_id_fkey", index: false)
    novel                        Novel?                     @relation(fields: [novelId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "codex_entries_novel_id_fkey", index: false)
    series                       Series?                    @relation(fields: [seriesId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "codex_entries_series_id_fkey", index: false)
    aliases                      CodexAlias[]
    tags                         CodexTag[]
    progressions                 CodexProgression[]
    sourceRelations              CodexRelation[]            @relation(name: "codex_relations_source_entry_id_fkey")
    targetRelations              CodexRelation[]            @relation(name: "codex_relations_target_entry_id_fkey")

    @@index([novelId, deletedAt], map: "codex_entries_novel_id_deleted_at_idx")
    @@index([ownerId, deletedAt], map: "codex_entries_owner_id_deleted_at_idx")
    @@index([seriesId, deletedAt], map: "codex_entries_series_id_deleted_at_idx")
    @@index([trackingMode], map: "codex_entries_tracking_mode_idx")
    @@index([type], map: "codex_entries_type_idx")
    @@map("codex_entries")
  }

  model CodexAlias {
    id        String        @id(map: "codex_aliases_pkey")
    name      String
    createdAt Timestamp(3)  @default(now()) @map("created_at")
    updatedAt Timestamp(3)  @map("updated_at")
    deletedAt Timestamp(3)? @map("deleted_at")
    entryId   String        @map("entry_id")

    entry     CodexEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "codex_aliases_entry_id_fkey", index: false)

    @@index([entryId, deletedAt], map: "codex_aliases_entry_id_deleted_at_idx")
    @@index([name], map: "codex_aliases_name_idx")
    @@map("codex_aliases")
  }

  model CodexTag {
    id        String        @id(map: "codex_tags_pkey")
    name      String
    color     String?
    createdAt Timestamp(3)  @default(now()) @map("created_at")
    updatedAt Timestamp(3)  @map("updated_at")
    deletedAt Timestamp(3)? @map("deleted_at")
    entryId   String        @map("entry_id")

    entry     CodexEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "codex_tags_entry_id_fkey", index: false)

    @@index([entryId, deletedAt], map: "codex_tags_entry_id_deleted_at_idx")
    @@index([name], map: "codex_tags_name_idx")
    @@map("codex_tags")
  }

  model CodexRelation {
    id            String        @id(map: "codex_relations_pkey")
    relationType  String        @map("relation_type")
    reverseType   String?       @map("reverse_type")
    description   String?
    createdAt     Timestamp(3)  @default(now()) @map("created_at")
    updatedAt     Timestamp(3)  @map("updated_at")
    deletedAt     Timestamp(3)? @map("deleted_at")
    sourceEntryId String        @map("source_entry_id")
    targetEntryId String        @map("target_entry_id")

    sourceEntry   CodexEntry    @relation(name: "codex_relations_source_entry_id_fkey", fields: [sourceEntryId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "codex_relations_source_entry_id_fkey", index: false)
    targetEntry   CodexEntry    @relation(name: "codex_relations_target_entry_id_fkey", fields: [targetEntryId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "codex_relations_target_entry_id_fkey", index: false)

    @@index([relationType], map: "codex_relations_relation_type_idx")
    @@index([sourceEntryId, deletedAt], map: "codex_relations_source_entry_id_deleted_at_idx")
    @@index([targetEntryId, deletedAt], map: "codex_relations_target_entry_id_deleted_at_idx")
    @@map("codex_relations")
  }

  model CodexProgression {
    id          String                   @id(map: "codex_progressions_pkey")
    mode        pg.enum(ProgressionMode) @default("ADDITION")
    description String
    notes       String?
    position    Int                      @default(0)
    createdAt   Timestamp(3)             @default(now()) @map("created_at")
    updatedAt   Timestamp(3)             @map("updated_at")
    deletedAt   Timestamp(3)?            @map("deleted_at")
    entryId     String                   @map("entry_id")
    sceneId     String                   @map("scene_id")

    entry       CodexEntry               @relation(fields: [entryId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "codex_progressions_entry_id_fkey", index: false)
    scene       Scene                    @relation(fields: [sceneId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "codex_progressions_scene_id_fkey", index: false)

    @@index([entryId, deletedAt], map: "codex_progressions_entry_id_deleted_at_idx")
    @@index([sceneId, deletedAt], map: "codex_progressions_scene_id_deleted_at_idx")
    @@index([sceneId, position], map: "codex_progressions_scene_id_position_idx")
    @@map("codex_progressions")
  }


  // BYOK encrypted provider credentials (STO-1178). Ciphertext is AES-256-GCM
  // with BYOK_ENCRYPTION_KEY; APIs never return ciphertext/iv/authTag/plaintext.
  model UserProviderCredential {
    id           String           @id(map: "user_provider_credentials_pkey")
    ownerId      String           @map("owner_id")
    provider     pg.enum(AiProvider)
    label        String           @default("default")

    ciphertext   Bytes?
    iv           Bytes?
    authTag      Bytes?           @map("auth_tag")
    keyHint      String?          @map("key_hint")
    keyVersion   Int              @default(1) @map("key_version")

    baseUrl      String?          @map("base_url")
    defaultModel String?          @map("default_model")
    defaultTemp  Float?           @map("default_temp")

    createdAt    Timestamp(3)     @default(now()) @map("created_at")
    updatedAt    Timestamp(3)     @map("updated_at")
    deletedAt    Timestamp(3)?    @map("deleted_at")

    owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "user_provider_credentials_owner_id_fkey", index: false)

    @@index([ownerId, deletedAt], map: "user_provider_credentials_owner_id_deleted_at_idx")
    @@index([ownerId, provider, deletedAt], map: "user_provider_credentials_owner_provider_deleted_at_idx")
    @@map("user_provider_credentials")
  }


  native_enum AiProvider {
    OPENROUTER = "OPENROUTER"
    OPENAI = "OPENAI"
    ANTHROPIC = "ANTHROPIC"
    OLLAMA = "OLLAMA"
    LMSTUDIO = "LMSTUDIO"
  }

  // Prompt templates + reusable components (STO-1158). SYSTEM_DEFAULT rows are
  // seeded read-only; authors Duplicate into their user library.
  model Prompt {
    id          String              @id(map: "prompts_pkey")
    name        String
    description String?
    mode        String
    scope       pg.enum(PromptScope) @default("USER")
    body        String              @default("")
    role        pg.enum(PromptRole) @default("SYSTEM")
    position    Int                 @default(0)
    isActive    Boolean             @default(true) @map("is_active")
    ownerId     String?             @map("owner_id")
    novelId     String?             @map("novel_id")
    createdAt   Timestamp(3)        @default(now()) @map("created_at")
    updatedAt   Timestamp(3)        @map("updated_at")
    deletedAt   Timestamp(3)?       @map("deleted_at")

    owner       User?               @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "prompts_owner_id_fkey", index: false)
    novel       Novel?              @relation(fields: [novelId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "prompts_novel_id_fkey", index: false)
    components  PromptComponentLink[]

    @@index([ownerId, deletedAt], map: "prompts_owner_id_deleted_at_idx")
    @@index([novelId, deletedAt], map: "prompts_novel_id_deleted_at_idx")
    @@index([mode, isActive, deletedAt], map: "prompts_mode_is_active_deleted_at_idx")
    @@map("prompts")
  }

  model PromptComponent {
    id          String              @id(map: "prompt_components_pkey")
    name        String
    description String?
    body        String
    role        pg.enum(PromptRole) @default("SYSTEM")
    // Versioned craft/portability contract (STO-1275). Null = legacy STO-1158 behavior.
    contract    Jsonb?              @map("contract")
    ownerId     String?             @map("owner_id")
    createdAt   Timestamp(3)        @default(now()) @map("created_at")
    updatedAt   Timestamp(3)        @map("updated_at")
    deletedAt   Timestamp(3)?       @map("deleted_at")

    owner       User?               @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "prompt_components_owner_id_fkey", index: false)
    links       PromptComponentLink[]

    @@index([ownerId, deletedAt], map: "prompt_components_owner_id_deleted_at_idx")
    @@map("prompt_components")
  }

  model PromptComponentLink {
    id          String          @id(map: "prompt_component_links_pkey")
    promptId    String          @map("prompt_id")
    componentId String          @map("component_id")
    position    Int             @default(0)
    enabled     Boolean         @default(true)
    createdAt   Timestamp(3)    @default(now()) @map("created_at")
    updatedAt   Timestamp(3)    @map("updated_at")
    deletedAt   Timestamp(3)?   @map("deleted_at")

    prompt      Prompt          @relation(fields: [promptId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "prompt_component_links_prompt_id_fkey", index: false)
    component   PromptComponent @relation(fields: [componentId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "prompt_component_links_component_id_fkey", index: false)

    @@index([promptId, position], map: "prompt_component_links_prompt_id_position_idx")
    @@index([componentId], map: "prompt_component_links_component_id_idx")
    @@map("prompt_component_links")
  }


  native_enum PromptRole {
    SYSTEM = "SYSTEM"
    USER = "USER"
  }

  native_enum PromptScope {
    SYSTEM_DEFAULT = "SYSTEM_DEFAULT"
    USER = "USER"
    NOVEL = "NOVEL"
  }

  native_enum CodexTrackingMode {
    ALWAYS = "ALWAYS"
    DETECTED = "DETECTED"
    NEVER = "NEVER"
  }

  native_enum CodexType {
    CHARACTER = "CHARACTER"
    LOCATION = "LOCATION"
    ITEM = "ITEM"
    LORE = "LORE"
    FACTION = "FACTION"
    CONCEPT = "CONCEPT"
    OTHER = "OTHER"
  }

  native_enum PlanTier {
    FREE = "FREE"
    PRO = "PRO"
    STUDIO = "STUDIO"
  }

  native_enum Pov {
    FIRST = "FIRST"
    SECOND = "SECOND"
    THIRD_LIMITED = "THIRD_LIMITED"
    THIRD_OMNISCIENT = "THIRD_OMNISCIENT"
  }

  native_enum ProgressionMode {
    ADDITION = "ADDITION"
    REPLACEMENT = "REPLACEMENT"
  }

  native_enum Tense {
    PAST = "PAST"
    PRESENT = "PRESENT"
    FUTURE = "FUTURE"
  }

  native_enum ContentFormat {
    PLAIN = "PLAIN"
    TIPTAP_JSON = "TIPTAP_JSON"
  }

  native_enum SceneRevisionReason {
    AUTOSAVE = "AUTOSAVE"
    MANUAL = "MANUAL"
    RESTORE = "RESTORE"
    IMPORT = "IMPORT"
  }
}
