{
  "name": "inkstory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "dotenv -e .env.local -e .env -- tsx --test tests/**/*.test.ts",
    "postinstall": "prisma contract emit",
    "contract:emit": "prisma contract emit",
    "db:verify": "prisma db verify",
    "db:sign": "prisma db sign",
    "db:update": "prisma db update",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@insforge/sdk": "^1.5.2",
    "@prisma/cli": "^8.0.0-rc.13",
    "@prisma/cli-engine": "^0.3.0",
    "@prisma/orm-postgres": "^8.0.0-rc.8",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.46.1",
    "@vercel/analytics": "^2.0.1",
    "next": "15.5.23",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "temporal-polyfill": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.5.23",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "prisma": "^8.0.0-rc.13",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "zod": "3.24.2"
  }
}
