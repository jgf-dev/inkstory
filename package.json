{
  "name": "inkstory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test",
    "test:cov": "vp test --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "prisma contract emit",
    "contract:emit": "prisma contract emit",
    "db:verify": "prisma db verify",
    "db:sign": "prisma db sign",
    "db:update": "prisma db update",
    "db:seed": "tsx prisma/seed.ts",
    "prepare": "vp config",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@prisma/orm-postgres": "8.0.0-rc.20",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-highlight": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "docx": "9.11.0",
    "dotenv": "^18.0.9",
    "mammoth": "1.13.0",
    "next": "^16.4.3",
    "node-html-parser": "9.0.4",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.1.0",
    "temporal-polyfill": "1.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@prisma/cli": "8.0.0-rc.22",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "10.6.1",
    "dotenv-cli": "11.0.0",
    "happy-dom": "^21.0.4",
    "oxlint": "1.90.0",
    "postcss": "^8.5.32",
    "prisma": "8.0.0-rc.27",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite-plus": "^1.4.0",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.10",
    "brace-expansion": "5.0.11",
    "hono": "4.12.25",
    "lodash": "4.18.0",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "vitest": {
      "vite": "8.2.4"
    }
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.28.2": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "workerd@1.20261002.1": true
  }
}
