{
  "name": "inkstory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "vp build",
    "dev": "vp dev --port 3000",
    "start": "vp preview",
    "lint": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test",
    "test:cov": "vp test --coverage",
    "test:db": "bun scripts/test-db.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "prisma contract emit",
    "contract:emit": "prisma contract emit",
    "db:verify": "prisma db verify",
    "db:sign": "prisma db sign",
    "db:update": "prisma db update",
    "db:seed": "vpx prisma/seed.ts",
    "prepare": "vp config",
    "cf-typegen": "cf workers types",
    "deploy:response-store": "cf deploy --prebuilt --mode production --worker inkstory-response-store",
    "preview": "vp build && vp preview",
    "deploy": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@cloudflare/workers-response-store": "^1.1.5",
    "@prisma/orm-postgres": "8.0.0-rc.20",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-highlight": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@vinext/cloudflare": "^1.3.3",
    "@voidzero-dev/vite-plus-core": "^1.5.0",
    "docx": "9.11.0",
    "dotenv": "^18.0.9",
    "mammoth": "1.13.0",
    "node-html-parser": "9.0.4",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "stripe": "^23.1.0",
    "temporal-polyfill": "1.0.4",
    "vinext": "^1.4.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@playwright/test": "^1.64.1",
    "@prisma/cli": "8.0.0-rc.22",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "10.6.1",
    "cf": "^1.0.0-beta.28",
    "dotenv-cli": "11.0.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "prisma": "8.0.0-rc.27",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.10",
    "brace-expansion": "5.0.11",
    "hono": "4.12.25",
    "lodash": "4.18.0",
    "minimatch": "10.2.6",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.28.2": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "workerd@1.20261002.1": true
  }
}
