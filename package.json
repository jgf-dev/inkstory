{
  "name": "inkstory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test",
    "test:cov": "vp test --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "prisma contract emit",
    "contract:emit": "prisma contract emit",
    "db:verify": "prisma db verify",
    "db:sign": "prisma db sign",
    "db:update": "prisma db update",
    "db:seed": "tsx prisma/seed.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.10",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tailwindcss/postcss": "4.3.3",
    "dotenv": "17.4.2",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "temporal-polyfill": "1.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@prisma/cli": "8.0.0-rc.13",
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "10.5.5",
    "dotenv-cli": "11.0.0",
    "oxlint": "1.82.0",
    "postcss": "8.5.28",
    "prisma": "8.0.0-rc.14",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite-plus": "0.3.3"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "workerd@1.20260704.1": true,
    "esbuild@0.28.2": true
  }
}
