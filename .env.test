# Local / CI test database only. Never point these at Supabase (prod or preview).
# Matches .github/workflows/sonarqube.yml and docker-compose.test.yml.
# `bun run test:db` may rewrite the host port via INKSTORY_TEST_POSTGRES_PORT or --port.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inkstory_test
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/inkstory_test

# Placeholders so the app can construct a Supabase client in E2E. Auth uses the
# non-production e2e-user cookie shim, not a real Supabase project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=e2e-anon-key
