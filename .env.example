# ─── Database (required) ───────────────────────────────────────────────────────
# Supabase Postgres (PostgreSQL >= 15; project uses Postgres 17).
# Use the Transaction pooler (port 6543) for runtime queries and the Session
# pooler (port 5432, IPv4, DDL-safe) for DIRECT_URL / schema updates.
# Find both in Supabase Dashboard → Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ─── Supabase Auth (required) ──────────────────────────────────────────────────
# Get these from Supabase Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_...your-publishable-or-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGc...your-service-role-key"
# Optional: JWKS URL (configured in cloudflare.config.ts for Workers deployments).
# NEXT_PUBLIC_SUPABASE_JWKS_URL="https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"

# ─── App & UI ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Kill switch: set to "0" to disable Writer / Stage / Architect operating modes.
# NEXT_PUBLIC_INKSTORY_OPERATING_MODES="1"
# Optional: Better Stack browser analytics tag (omitted outside production / when unset).
# NEXT_PUBLIC_BETTERSTACK_TOKEN=""
# Optional: override Better Stack environment tag (defaults to hostname detection: production vs preview).
# NEXT_PUBLIC_BETTERSTACK_ENV=""

# ─── Cloudflare Turnstile (required for /api/auth/login & /api/auth/signup) ───
# Auth endpoints fail closed (HTTP 403) when TURNSTILE_SECRET or
# TURNSTILE_HOSTNAMES is empty. For local development, use your Turnstile widget
# keys or Cloudflare's official Turnstile testing keys.
# Note: `NEXT_PUBLIC_TURNSTILE_SITE_KEY` matches `cloudflare.config.ts`
# (`NEXT_PUBLIC_TURNSTILE_KEY` is also accepted as a fallback).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""
# Comma-separated frontend hostnames accepted from Turnstile siteverify.
# Local dev only — NEVER include localhost or 127.0.0.1 in production.
TURNSTILE_HOSTNAMES="localhost,127.0.0.1"

# ─── AI generation (optional — zero-spend fallback when unset) ─────────────────
# Vercel AI Gateway (OpenAI-compatible). While AI_GATEWAY_API_KEY is empty and
# no BYOK credential is selected, POST /api/ai/generate returns 503
# AI_NOT_CONFIGURED along with the fully assembled prompt for manual copy/paste.
AI_GATEWAY_API_KEY=""
AI_GATEWAY_BASE_URL="https://ai-gateway.vercel.sh/v1"
AI_MODEL="anthropic/claude-sonnet-4.6"

# ─── BYOK credential encryption (optional — required to save BYOK API keys) ───
# 32-byte master key, base64-encoded. Generate with:
#   openssl rand -base64 32
# Never commit a real value. Never expose via NEXT_PUBLIC_*.
BYOK_ENCRYPTION_KEY=""

# ─── Stripe billing (optional — returns 503 BILLING_NOT_CONFIGURED when unset) ─
# Create test-mode products/prices in the Stripe dashboard, then paste IDs.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_STUDIO_MONTHLY=""

# ─── Local testing overrides (optional — tests load committed `.env.test`) ────
# INKSTORY_TEST_POSTGRES_PORT="55432"
# INKSTORY_TEST_POSTGRES_IMAGE="postgres:17"
# INKSTORY_NO_DB="1"
# E2E mock auth bypass (Playwright sets this automatically; ignored in production):
# NEXT_PUBLIC_E2E="true"
