# ─── Database ──────────────────────────────────────────────────────────────────
# Supabase Postgres. Use the "Transaction" pooler URL for runtime queries and
# the "Direct" URL for migrations. Find both in Supabase Dashboard → Settings →
# Database → Connection string.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ─── Supabase Auth ─────────────────────────────────────────────────────────────
# Get these from Supabase Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGc...your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGc...your-service-role-key"

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Stripe (test mode until launch) ──────────────────────────────────────────
# Create test-mode products/prices in the Stripe dashboard, then paste ids.
# Billing routes answer 503 BILLING_NOT_CONFIGURED while these are empty.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_STUDIO_MONTHLY=""

# ─── AI generation (launch phase 3) ───────────────────────────────────────────
# Vercel AI Gateway (OpenAI-compatible). While AI_GATEWAY_API_KEY is empty,
# POST /api/ai/generate answers 503 AI_NOT_CONFIGURED and still returns the
# fully assembled prompt for manual copy/paste — no spend can occur.
AI_GATEWAY_API_KEY=""
AI_GATEWAY_BASE_URL="https://ai-gateway.vercel.sh/v1"
AI_MODEL="anthropic/claude-sonnet-4.6"

